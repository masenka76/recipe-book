<!DOCTYPE html>
<html lang="{{ recipe.language or 'ru' }}">
<head>
  <meta charset="utf-8">
  <title>{{ recipe.title }}</title>
  <link rel="stylesheet" href="recipe.css">
</head>
<body>
  <header class="cover">
    <h1>{{ recipe.title }}</h1>
    {% set meta = [recipe.servings, recipe.total_time, recipe.yields] | select | list %}
    {% if meta %}
    <p class="meta">{{ meta | join(' &nbsp;·&nbsp; ') }}</p>
    {% endif %}
    {% if tags %}
    <ul class="tags">
      {% for tag in tags %}<li>{{ tag }}</li>{% endfor %}
    </ul>
    {% endif %}
  </header>

  <main>
    <section class="ingredients">
      <h2>Ингредиенты</h2>
      <ul>
        {% for item in recipe.ingredients %}<li>{{ item }}</li>{% endfor %}
      </ul>
    </section>

    <section class="steps">
      <h2>Приготовление</h2>
      <ol>
        {% for step in recipe.steps %}<li>{{ step }}</li>{% endfor %}
      </ol>
    </section>

    {% if recipe.notes %}
    <section class="notes">
      <h2>Заметки</h2>
      <p>{{ recipe.notes }}</p>
    </section>
    {% endif %}
  </main>

  <footer>
    {% if recipe.source_url %}
    <p class="source">Источник: <a href="{{ recipe.source_url }}">{{ recipe.source_url }}</a></p>
    {% elif recipe.source_name %}
    <p class="source">Источник: {{ recipe.source_name }}</p>
    {% endif %}
    <p class="added">В книгу добавлено: {{ recipe.date_added }}</p>
  </footer>
</body>
</html>
